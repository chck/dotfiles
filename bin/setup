#!/bin/sh
set -e

mitamae_version="2.0.3"
mitamae_x86_64_linux_sha256="61c6b2a678f45c1374506874846cf362bc418e4914d0cf5eb56351210dcb930"
mitamae_x86_64_darwin_sha256="1af8d2cf3fd392b8ee62b01b7e54ada4080b09117b3abb9db1cd2a43fb7ee64b"
mitamae_aarch64_darwin_sha256="acd0bbaa32832e4d7724f5c393229f0eb7ab8a96d8951e1fe7cdd0967234b69e"

mitamae_cache="mitamae-${mitamae_version}"
if ! [ -f "bin/${mitamae_cache}" ]; then
  case "$(uname)" in
    "Linux")
      mitamae_bin="mitamae-x86_64-linux"
      mitamae_sha256="$mitamae_x86_64_linux_sha256"
      ;;
    "Darwin")
      if [[ $(uname -m) == "x86_64" ]]; then
	mitamae_bin="mitamae-x86_64-darwin"
	mitamae_sha256="$mitamae_x86_64_darwin_sha256"
      else
	mitamae_bin="mitamae-aarch64-darwin"
	mitamae_sha256="$mitamae_aarch64_darwin_sha256"
      fi
      ;;
    *)
      echo "unexpected uname: $(uname)"
      exit 1
      ;;
  esac

  curl -o "bin/${mitamae_bin}" -fL "https://github.com/itamae-kitchen/mitamae/releases/download/v${mitamae_version}/${mitamae_bin}"
  sha256="$(/usr/bin/openssl dgst -sha256 "bin/${mitamae_bin}" | cut -d" " -f2)"
  if [ "$mitamae_sha256" != "$sha256" ]; then
    echo "checksum verification failed!\nexpected: ${mitamae_sha256}\n  actual: ${sha256}"
    rm -f "bin/${mitamae_bin}"
    exit 1
  fi

  mv "bin/${mitamae_bin}" "bin/${mitamae_cache}"
  chmod +x "bin/${mitamae_cache}"
fi
ln -sf "${mitamae_cache}" bin/mitamae
