{
  "permissions": {
    "allow": [
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git merge --ff-only:*)",
      "Bash(gh pr merge:*)"
    ],
    "defaultMode": "auto"
  },
  "skillOverrides": {
    "init-infra": "user-invocable-only",
    "skill-audit": "user-invocable-only",
    "work-digest": "user-invocable-only"
  },
  "enabledPlugins": {
    "claude-code-wakatime@wakatime": true,
    "claude-mem@thedotmack": true,
    "commit-commands@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "terraform@claude-plugins-official": true,
    "diagram-design@diagram-design": true,
    "caveman@caveman": true
  },
  "extraKnownMarketplaces": {
    "wakatime": {
      "source": {
        "source": "git",
        "url": "https://github.com/wakatime/claude-code-wakatime.git"
      }
    },
    "thedotmack": {
      "source": {
        "source": "git",
        "url": "https://github.com/thedotmack/claude-mem.git"
      }
    },
    "ailab": {
      "source": {
        "source": "git",
        "url": "https://github.com/CyberAgentAILab/claude-plugins.git"
      }
    },
    "diagram-design": {
      "source": {
        "source": "git",
        "url": "https://github.com/cathrynlavery/diagram-design.git"
      }
    },
    "caveman": {
      "source": {
        "source": "git",
        "url": "https://github.com/JuliusBrussee/caveman.git"
      }
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
